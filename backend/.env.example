# Backend API Server Configuration
PORT=5000
NODE_ENV=production

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Durable External Production Database (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgres://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Local Engine & Storage Fallbacks
DB_PATH=data/workflow.db
UPLOAD_DIR=uploads
